{
  "testing.defaultGutterClickAction": "run",
  "testing.automaticallyOpenPeekView": "never",
  "testing.followRunningTest": true,
  "testing.gutterEnabled": true,
  "testing.openTesting": "openExplorer",
  "typescript.preferences.includePackageJsonAutoImports": "auto",
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "files.associations": {
    "*.test.ts": "typescript",
    "*.test.js": "javascript"
  },
    "jest.enable": false,
  "testing.automaticallyOpenTestResults": "openExplorer",
  
    // The path to the `bun` executable.
    "bun.runtime": "bun",

    // If support for Bun should be added to the default "JavaScript Debug Terminal".
    "bun.debugTerminal.enabled": true,
  
    // If the debugger should stop on the first line of the program.
    "bun.debugTerminal.stopOnEntry": false,
  
    // Glob pattern to find test files. Defaults to the value shown below.
    "bun.test.filePattern": "**/*{.test.,.spec.,_test_,_spec_}{js,ts,tsx,jsx,mts,cts,cjs,mjs}",
  
  
}
